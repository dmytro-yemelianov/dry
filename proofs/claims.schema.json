{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dry.dev/schemas/proof-claims-v1.schema.json",
  "title": "Dry proof claim registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "claim": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    }
  },
  "$defs": {
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "abstract",
        "numeric",
        "refinement"
      ],
      "properties": {
        "abstract": {
          "enum": [
            "specified",
            "proved",
            "not-applicable"
          ]
        },
        "numeric": {
          "enum": [
            "pending",
            "bounded",
            "empirical",
            "not-applicable"
          ]
        },
        "refinement": {
          "enum": [
            "pending",
            "checked",
            "not-applicable"
          ]
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "theorem",
        "spec_version",
        "source_dialect",
        "target_dialect",
        "relation",
        "scope",
        "numeric_domain",
        "assumptions",
        "exclusions",
        "lean_source",
        "rust_sources",
        "refinement_evidence",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FM1\\.[A-Z][A-Z0-9_.-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "theorem": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.]*$"
        },
        "spec_version": {
          "type": "string",
          "minLength": 1
        },
        "source_dialect": {
          "type": "string",
          "minLength": 1
        },
        "target_dialect": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "enum": [
            "exact",
            "bit-exact",
            "trace-exact",
            "approximate",
            "observational",
            "capability-refinement",
            "invariant-preservation",
            "rejection"
          ]
        },
        "scope": {
          "enum": [
            "abstract",
            "implementation"
          ]
        },
        "numeric_domain": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lean_source": {
          "type": "string",
          "pattern": "^formal/Dry/.+\\.lean$"
        },
        "rust_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^crates/.+\\.rs$"
          }
        },
        "numeric_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "refinement_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    }
  }
}
