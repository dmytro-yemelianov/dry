{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dry.dev/schemas/composition-shape-refinement-fixtures-v0.json",
  "title": "Dry parenthesized composition-shape refinement fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model", "model_checks", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "model": { "const": "composition-shape-refinement-v0" },
    "model_checks": { "const": true },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [
        { "type": "integer" },
        { "type": "integer" },
        { "type": "integer" }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z", "rotate_z_deg"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "z": { "type": "integer" },
        "rotate_z_deg": { "type": "integer" }
      }
    },
    "move": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "x", "y", "z"],
      "properties": {
        "op": { "const": "move" },
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "z": { "type": "integer" }
      }
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pose", "ops"],
          "properties": {
            "kind": { "const": "feature" },
            "pose": { "$ref": "#/$defs/pose" },
            "ops": {
              "type": "array",
              "items": { "$ref": "#/$defs/move" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "count", "step", "child"],
          "properties": {
            "kind": { "const": "repeat" },
            "count": { "type": "integer", "minimum": 0 },
            "step": { "$ref": "#/$defs/pose" },
            "child": { "$ref": "#/$defs/node" }
          }
        }
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_ops", "max_nodes", "max_depth"],
      "properties": {
        "max_ops": { "type": "integer", "minimum": 0 },
        "max_nodes": { "type": "integer", "minimum": 0 },
        "max_depth": { "type": "integer", "minimum": 0 }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["features"],
      "properties": {
        "features": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/node" }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "limits", "program", "expected_points", "tolerance"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "limits": { "$ref": "#/$defs/limits" },
        "program": { "$ref": "#/$defs/program" },
        "expected_points": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/point" }
        },
        "tolerance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1e-12
        }
      }
    }
  }
}
