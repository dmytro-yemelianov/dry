{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dry.dev/schemas/native-feature-numeric-interval-fixtures-v0.json",
  "title": "Dry native planar feature numeric interval witnesses",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model",
    "model_checks",
    "budgets",
    "limits",
    "pose_cases",
    "compose_cases",
    "point_application_cases",
    "xy_application_cases",
    "vector_application_cases"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "model": { "const": "native-feature-numeric-interval-v0" },
    "model_checks": { "const": true },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "angle",
        "trig",
        "compose_rotation",
        "compose_translation",
        "point",
        "arc_center",
        "orientation"
      ],
      "properties": {
        "angle": { "$ref": "#/$defs/budget" },
        "trig": { "$ref": "#/$defs/budget" },
        "compose_rotation": { "$ref": "#/$defs/budget" },
        "compose_translation": { "$ref": "#/$defs/budget" },
        "point": { "$ref": "#/$defs/budget" },
        "arc_center": { "$ref": "#/$defs/budget" },
        "orientation": { "$ref": "#/$defs/budget" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_coordinate_abs",
        "pose_translation_abs",
        "pose_rotation_abs_deg",
        "arc_center_abs",
        "orientation_component_abs",
        "multiply_exact_result_abs",
        "add_sub_exact_result_abs",
        "radian_intermediate_abs"
      ],
      "properties": {
        "local_coordinate_abs": { "const": 1048576 },
        "pose_translation_abs": { "const": 1048576 },
        "pose_rotation_abs_deg": { "const": 360 },
        "arc_center_abs": { "const": 1048576 },
        "orientation_component_abs": { "const": 1 },
        "multiply_exact_result_abs": { "const": 1048576 },
        "add_sub_exact_result_abs": { "const": 4194304 },
        "radian_intermediate_abs": { "const": 7 }
      }
    },
    "pose_cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/poseCase" }
    },
    "compose_cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/composeCase" }
    },
    "point_application_cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pointApplicationCase" }
    },
    "xy_application_cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/xyApplicationCase" }
    },
    "vector_application_cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/vectorApplicationCase" }
    }
  },
  "$defs": {
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ceiling"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FM1\\.NUMERIC\\.PROFILE\\.FEATURE\\.PLANAR\\.V0\\.BUDGET\\.[A-Z0-9_.-]+$"
        },
        "ceiling": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z", "rotate_z_deg"],
      "properties": {
        "x": { "type": "integer", "minimum": -1048576, "maximum": 1048576 },
        "y": { "type": "integer", "minimum": -1048576, "maximum": 1048576 },
        "z": { "type": "integer", "minimum": -1048576, "maximum": 1048576 },
        "rotate_z_deg": { "type": "integer", "minimum": -360, "maximum": 360 }
      }
    },
    "coefficient": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": -1, "maximum": 1 },
        { "type": "integer", "minimum": -1, "maximum": 1 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "point": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": -4194304, "maximum": 4194304 },
        { "type": "integer", "minimum": -4194304, "maximum": 4194304 },
        { "type": "integer", "minimum": -4194304, "maximum": 4194304 }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "localPoint": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": -1048576, "maximum": 1048576 },
        { "type": "integer", "minimum": -1048576, "maximum": 1048576 },
        { "type": "integer", "minimum": -1048576, "maximum": 1048576 }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "xy": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": -4194304, "maximum": 4194304 },
        { "type": "integer", "minimum": -4194304, "maximum": 4194304 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "localXY": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": -1048576, "maximum": 1048576 },
        { "type": "integer", "minimum": -1048576, "maximum": 1048576 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "orientation": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": -1, "maximum": 1 },
        { "type": "integer", "minimum": -1, "maximum": 1 },
        { "type": "integer", "minimum": -1, "maximum": 1 }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "radianBounds": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -7, "maximum": 7 },
        { "type": "number", "minimum": -7, "maximum": 7 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "poseCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pose", "radian_bounds", "expected_coefficient"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "pose": { "$ref": "#/$defs/pose" },
        "radian_bounds": { "$ref": "#/$defs/radianBounds" },
        "expected_coefficient": { "$ref": "#/$defs/coefficient" }
      }
    },
    "composeCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parent",
        "local",
        "expected_coefficient",
        "expected_translation"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "parent": { "$ref": "#/$defs/pose" },
        "local": { "$ref": "#/$defs/pose" },
        "expected_coefficient": { "$ref": "#/$defs/coefficient" },
        "expected_translation": { "$ref": "#/$defs/point" }
      }
    },
    "pointApplicationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "transform", "point", "expected"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "transform": { "$ref": "#/$defs/pose" },
        "point": { "$ref": "#/$defs/localPoint" },
        "expected": { "$ref": "#/$defs/point" }
      }
    },
    "xyApplicationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "transform", "point", "expected"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "transform": { "$ref": "#/$defs/pose" },
        "point": { "$ref": "#/$defs/localXY" },
        "expected": { "$ref": "#/$defs/xy" }
      }
    },
    "vectorApplicationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "transform", "vector", "expected"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "transform": { "$ref": "#/$defs/pose" },
        "vector": { "$ref": "#/$defs/orientation" },
        "expected": { "$ref": "#/$defs/orientation" }
      }
    }
  }
}
