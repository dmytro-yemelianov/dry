# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Node (SDKs / web)
node_modules/
dist/
*.tsbuildinfo
.wrangler/
*.cpuprofile
.lake/

# wasm build artifacts (rebuilt by web/build.sh + CI; never committed — keeps the repo binary-free)
web/pkg/
web/pkg-node/
web/fullcontrol-gallery.generated.js
sdk/ts/wasm/
dist-site/

# Playwright MCP scratch (headless verification)
.playwright-mcp/

# OS / editor
.DS_Store
.idea/
.vscode/

# Python / maturin
**/target/
.venv/
__pycache__/
*.so
*.egg-info/
.pytest_cache/

# Claude Code harness worktrees (per-agent, transient)
.claude/worktrees/
.superpowers/

# slicer-corpus regeneration output: local-only, too large to commit in bulk
# (conformance/slicer-corpus/ holds the frozen, committed sample instead).
tools/slicer_corpus/models/
tools/slicer_corpus/full-corpus/
# OrcaSlicer writes a numbered log file to the CWD it was launched from
# unless --logfile is given; slice_matrix.sh passes --logfile, but this is
# defense-in-depth against a stray one from a manual invocation.
/[0-9][0-9][0-9][0-9][0-9].log
