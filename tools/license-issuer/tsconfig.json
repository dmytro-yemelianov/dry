{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.mjs", "test/**/*.ts", "vitest.config.ts", "worker-configuration.d.ts"]
}
