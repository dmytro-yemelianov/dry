    "TraceAnalytics": {
      "description": "Higher-level statistics over a TraceSummary, present only when the caller asked for them (`trace-gcode --analytics`). Window statistics are over per-window *peaks*, unweighted, over windows with duration_s > 0 \u2014 zero-duration windows carry no motion and are excluded. `windows_considered`/`segments_considered` are published rather than inferred: a statistic computed over almost nothing must not be indistinguishable from one computed over a whole print.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "print",
        "travel",
        "window_flow_mm3_s",
        "window_feedrate_mm_min",
        "flow_outliers",
        "layer_stats",
        "layer_z_epsilon_mm",
        "travel_time_ratio",
        "windows_considered",
        "segments_considered"
      ],
      "properties": {
        "print": {
          "$ref": "#/$defs/PhaseStats"
        },
        "travel": {
          "$ref": "#/$defs/PhaseStats"
        },
        "window_flow_mm3_s": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Percentiles"
            }
          ]
        },
        "window_feedrate_mm_min": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Percentiles"
            }
          ]
        },
        "flow_outliers": {
          "$ref": "#/$defs/WindowOutliers"
        },
        "layer_stats": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/LayerStats"
            }
          ]
        },
        "layer_z_epsilon_mm": {
          "type": "number",
          "minimum": 0,
          "description": "the Z tolerance the layer partition ran with, echoed from the options the way flow_outliers.k is \u2014 so both tolerances in the document are self-describing. Echoed unconditionally, including when it produced no layers at all"
        },
        "travel_time_ratio": {
          "type": [
            "number",
            "null"
          ],
          "description": "travel motion time / total motion time, in [0,1]; null when nothing moved"
        },
        "windows_considered": {
          "type": "integer",
          "minimum": 0
        },
        "segments_considered": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
