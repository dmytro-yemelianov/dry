    "FindingsDelta": {
      "description": "Verify findings added (present only in `after`) and removed (present only in `before`), each keyed `\"<rule>@<source_line>\"` \u2014 a finding that moved lines is reported as removed+added rather than silently kept.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before_count",
        "after_count",
        "added",
        "removed"
      ],
      "properties": {
        "before_count": {
          "type": "integer",
          "minimum": 0
        },
        "after_count": {
          "type": "integer",
          "minimum": 0
        },
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "CompareDelta": {
      "description": "The deterministic two-file forensic diff behind `dry compare --json` (docs/11 \u00a73.7). `slicer` is `null` when the detected slicer is unchanged; `settings` lists only the fields that differ. `layer_count` and `retractions` are counts carried as `ScalarDelta` so every metric in the envelope has the same shape. The `--llm` narrative envelope wraps this one and is not part of this schema \u2014 model output is not drift-gated.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slicer",
        "time",
        "peak_flow_mm3_s",
        "layer_count",
        "travel_distance_mm",
        "retractions",
        "settings",
        "findings"
      ],
      "properties": {
        "slicer": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/StringChange"
            }
          ]
        },
        "time": {
          "$ref": "#/$defs/TimeDelta"
        },
        "peak_flow_mm3_s": {
          "$ref": "#/$defs/ScalarDelta"
        },
        "layer_count": {
          "$ref": "#/$defs/ScalarDelta"
        },
        "travel_distance_mm": {
          "$ref": "#/$defs/ScalarDelta"
        },
        "retractions": {
          "$ref": "#/$defs/ScalarDelta"
        },
        "settings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SettingChange"
          }
        },
        "findings": {
          "$ref": "#/$defs/FindingsDelta"
        },
        "license": {
          "$ref": "#/$defs/LicenseStamp"
        }
      }
    }
