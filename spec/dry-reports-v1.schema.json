    "ScalarDelta": {
      "description": "before/after for a numeric metric. `pct` is `null` when `before` is zero \u2014 there is no percent change from nothing, and the delta says so rather than reporting 0 or an infinity.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "after",
        "abs",
        "pct"
      ],
      "properties": {
        "before": {
          "type": "number"
        },
        "after": {
          "type": "number"
        },
        "abs": {
          "type": "number",
          "description": "after - before"
        },
        "pct": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "StringChange": {
      "description": "before/after for a categorical value; only constructed when the two differ.",
      "type": "object",
      "additionalProperties": false,
      "required": [
