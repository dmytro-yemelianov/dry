{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dmytro-yemelianov/dry/spec/dry-reports-v1.schema.json",
  "title": "Dry report outputs v1",
  "description": "Schemas for Dry's report outputs (see docs/11-profiles-and-reports.md): the verify Report, the review-gcode report, and the trace-gcode report. Use the $defs by name to validate a given output: VerifyReport, ReviewReport, TraceReport.",
  "$defs": {
    "Severity": {
      "type": "string",
      "enum": ["error", "warning"]
    },
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "severity", "segment", "message"],
      "properties": {
        "rule": { "type": "string", "description": "stable kebab-case rule id (see the rule catalog)" },
        "severity": { "$ref": "#/$defs/Severity" },
        "segment": { "type": ["integer", "null"], "minimum": 0 },
        "message": { "type": "string" }
      }
    },
    "LocatedFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "severity", "segment", "source_line", "message"],
      "properties": {
        "rule": { "type": "string" },
        "severity": { "$ref": "#/$defs/Severity" },
        "segment": { "type": ["integer", "null"], "minimum": 0 },
        "source_line": { "type": ["integer", "null"], "minimum": 0 },
        "message": { "type": "string" }
      }
    },
    "Metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_time_s",
        "print_time_s",
        "travel_time_s",
        "extruding_distance",
        "travel_distance",
        "extruded_volume",
        "filament_length",
        "segment_count",
        "max_flow_rate"
      ],
      "properties": {
        "total_time_s": { "type": "number" },
        "print_time_s": { "type": "number" },
        "travel_time_s": { "type": "number" },
        "extruding_distance": { "type": "number" },
        "travel_distance": { "type": "number" },
        "extruded_volume": { "type": "number" },
        "filament_length": { "type": "number" },
        "segment_count": { "type": "integer", "minimum": 0 },
        "max_flow_rate": { "type": "number" }
      }
    },
    "Contracts": {
      "description": "The limits a toolpath was verified against. An absent field disables that check.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bounds": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }
        },
        "max_flow": { "type": "number" },
        "speed_range": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
        "monotonic_z": { "type": "boolean" },
        "min_temp": { "type": "number" },
        "max_retraction_distance": { "type": "number" },
        "max_retraction_speed": { "type": "number" },
        "max_travel_without_retract": { "type": "number" },
        "first_layer_height_range": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
        "first_layer_speed_range": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
        "bead_volume_tolerance": { "type": "number" },
        "kinematics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_acceleration_mm_s2": { "type": "number" },
            "max_junction_velocity_mm_s": { "type": "number" }
          }
        },
        "rotary": {
          "description": "Rotary-axis limits and reachable workspace of a 5-axis machine. `model` is the rotary mapping the orientations were resolved through — the same one the emitter uses — and is always echoed so the angles in a finding can be reproduced.",
          "type": "object",
          "additionalProperties": false,
          "required": ["model"],
          "properties": {
            "model": { "$ref": "#/$defs/Kinematics" },
            "travel_deg": {
              "description": "Per-axis rotary travel [min,max] in degrees, keyed by axis letter. An absent axis is unconstrained.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "a": { "$ref": "#/$defs/Range" },
                "b": { "$ref": "#/$defs/Range" },
                "c": { "$ref": "#/$defs/Range" }
              }
            },
            "max_rotary_feed_deg_min": { "type": "number" },
            "envelope_mm": {
              "description": "[[x_lo,x_hi],[y_lo,y_hi],[z_lo,z_hi]] in mm, in MACHINE coordinates (after the rotation is applied) — not the build volume.",
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": { "$ref": "#/$defs/Range" }
            }
          }
        }
      }
    },
    "Range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number" }
    },
    "LicenseStamp": {
      "description": "Which licensing mode produced a report. Stamped by the CLI, never by the engine: reports the engine builds carry no `license` key at all, so the property is optional everywhere it appears and older reports stay valid.",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "description": "`licensed` or `evaluation`" },
        "licensee": { "type": "string" },
        "tier": { "type": "string" }
      }
    },
    "Kinematics": {
      "description": "A 5-axis rotary model: which two rotary axes carry the toolframe orientation, plus mechanical offsets.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "pivot_offset", "rotary_offset"],
      "properties": {
        "type": { "type": "string", "enum": ["ab", "ac", "bc"] },
        "pivot_offset": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number" }
        },
        "rotary_offset": { "$ref": "#/$defs/Range" }
      }
    },
    "VerifyReport": {
      "description": "A verification result. `findings` alone cannot distinguish a clean pass from a vacuous one, so a report also states how much it inspected (`segments_inspected`), which rules were in force (`rules_evaluated`), and against what limits (`contracts`). All three are optional: reports written before Dry 0.5 carry only `findings` and remain valid.",
      "type": "object",
      "additionalProperties": false,
      "required": ["findings"],
      "properties": {
        "findings": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
        "segments_inspected": { "type": "integer", "minimum": 0 },
        "rules_evaluated": { "type": "array", "items": { "type": "string" } },
        "contracts": { "$ref": "#/$defs/Contracts" },
        "license": { "$ref": "#/$defs/LicenseStamp" }
      }
    },
    "ReviewReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "profile", "segments", "metrics", "findings", "error_count"],
      "properties": {
        "file": { "type": ["string", "null"] },
        "profile": { "type": ["string", "null"] },
        "segments": { "type": "integer", "minimum": 0 },
        "metrics": { "$ref": "#/$defs/Metrics" },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/LocatedFinding" } },
        "error_count": { "type": "integer", "minimum": 0 },
        "license": { "$ref": "#/$defs/LicenseStamp" }
      }
    },
    "TraceWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "start_time_s",
        "end_time_s",
        "segment_start",
        "segment_end",
        "duration_s",
        "print_time_s",
        "travel_time_s",
        "dwell_time_s",
        "extruding_distance_mm",
        "travel_distance_mm",
        "extruded_volume_mm3",
        "filament_mm",
        "max_feedrate_mm_min",
        "max_flow_mm3_s"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "start_time_s": { "type": "number" },
        "end_time_s": { "type": "number" },
        "segment_start": { "type": ["integer", "null"], "minimum": 0 },
        "segment_end": { "type": ["integer", "null"], "minimum": 0 },
        "source_line_start": { "type": "integer", "minimum": 0 },
        "source_line_end": { "type": "integer", "minimum": 0 },
        "duration_s": { "type": "number" },
        "print_time_s": { "type": "number" },
        "travel_time_s": { "type": "number" },
        "dwell_time_s": { "type": "number" },
        "extruding_distance_mm": { "type": "number" },
        "travel_distance_mm": { "type": "number" },
        "extruded_volume_mm3": { "type": "number" },
        "filament_mm": { "type": "number" },
        "max_feedrate_mm_min": { "type": "number" },
        "max_flow_mm3_s": { "type": "number" }
      }
    },
    "TraceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_s",
        "segment_count",
        "moving_segment_count",
        "total_time_s",
        "print_time_s",
        "travel_time_s",
        "dwell_time_s",
        "extruding_distance_mm",
        "travel_distance_mm",
        "extruded_volume_mm3",
        "filament_mm",
        "max_feedrate_mm_min",
        "max_flow_mm3_s",
        "windows",
        "layers"
      ],
      "properties": {
        "window_s": { "type": "number" },
        "segment_count": { "type": "integer", "minimum": 0 },
        "moving_segment_count": { "type": "integer", "minimum": 0 },
        "total_time_s": { "type": "number" },
        "print_time_s": { "type": "number" },
        "travel_time_s": { "type": "number" },
        "dwell_time_s": { "type": "number" },
        "extruding_distance_mm": { "type": "number" },
        "travel_distance_mm": { "type": "number" },
        "extruded_volume_mm3": { "type": "number" },
        "filament_mm": { "type": "number" },
        "max_feedrate_mm_min": { "type": "number" },
        "max_flow_mm3_s": { "type": "number" },
        "windows": { "type": "array", "items": { "$ref": "#/$defs/TraceWindow" } },
        "layers": { "type": "array", "items": { "$ref": "#/$defs/LayerTraceLinkage" } }
      }
    },
    "LayerTraceLinkage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer_index",
        "z_mm",
        "segment_start",
        "segment_end",
        "print_time_s",
        "travel_time_s",
        "extruded_volume_mm3"
      ],
      "properties": {
        "layer_index": { "type": "integer", "minimum": 0 },
        "z_mm": { "type": "number" },
        "segment_start": { "type": "integer", "minimum": 0 },
        "segment_end": { "type": "integer", "minimum": 0 },
        "print_time_s": { "type": "number" },
        "travel_time_s": { "type": "number" },
        "extruded_volume_mm3": { "type": "number" }
      }
    },

    "TraceReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "profile", "trace"],
      "properties": {
        "file": { "type": ["string", "null"] },
        "profile": { "type": ["string", "null"] },
        "trace": { "$ref": "#/$defs/TraceSummary" }
      }
    },
    "Confidence": {
      "type": "string",
      "enum": ["measured", "from-comment", "inferred"]
    },
    "Estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "note"],
      "properties": {
        "value": { "type": ["number", "null"] },
        "confidence": { "$ref": "#/$defs/Confidence" },
        "note": { "type": "string" }
      }
    },
    "FeatureStat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature",
        "source",
        "segments",
        "extruding_distance_mm",
        "time_s",
        "min_speed_mm_min",
        "max_speed_mm_min",
        "peak_flow_mm3_s"
      ],
      "properties": {
        "feature": { "type": "string" },
        "source": { "$ref": "#/$defs/Confidence" },
        "segments": { "type": "integer", "minimum": 0 },
        "extruding_distance_mm": { "type": "number" },
        "time_s": { "type": "number" },
        "min_speed_mm_min": { "type": "number" },
        "max_speed_mm_min": { "type": "number" },
        "peak_flow_mm3_s": { "type": "number" }
      }
    },
    "LayerModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer_count", "layer_height_mm"],
      "properties": {
        "layer_count": { "type": "integer", "minimum": 0 },
        "layer_height_mm": { "$ref": "#/$defs/Estimate" }
      }
    },
    "TravelStat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["travel_moves", "travel_distance_mm", "retractions"],
      "properties": {
        "travel_moves": { "type": "integer", "minimum": 0 },
        "travel_distance_mm": { "type": "number" },
        "retractions": { "type": "integer", "minimum": 0 }
      }
    },
    "Hotspot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "count", "note"],
      "properties": {
        "kind": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "note": { "type": "string" }
      }
    },
    "DeclaredSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layer_height_mm": { "type": ["number", "null"] },
        "extrusion_width_mm": { "type": ["number", "null"] },
        "infill_angle_deg": { "type": ["number", "null"] },
        "infill_density": { "type": ["string", "null"] }
      }
    },
    "SeamHint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "loops", "source"],
      "properties": {
        "strategy": { "type": "string" },
        "loops": { "type": "integer", "minimum": 0 },
        "source": { "$ref": "#/$defs/Confidence" }
      }
    },
    "TravelStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["z_hops", "retraction_ratio", "hint", "source"],
      "properties": {
        "z_hops": { "type": "integer", "minimum": 0 },
        "retraction_ratio": { "type": "number" },
        "hint": { "type": "string" },
        "source": { "$ref": "#/$defs/Confidence" }
      }
    },
    "ForensicsReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slicer",
        "source_lines",
        "segment_count",
        "layers",
        "line_width_mm",
        "declared",
        "features",
        "infill_angles_deg",
        "infill_spacing_mm",
        "extrusion_multiplier",
        "seam",
        "travel",
        "travel_strategy",
        "hotspots"
      ],
      "properties": {
        "slicer": { "type": "string" },
        "source_lines": { "type": "integer", "minimum": 0 },
        "segment_count": { "type": "integer", "minimum": 0 },
        "layers": { "$ref": "#/$defs/LayerModel" },
        "line_width_mm": { "$ref": "#/$defs/Estimate" },
        "declared": { "$ref": "#/$defs/DeclaredSettings" },
        "features": { "type": "array", "items": { "$ref": "#/$defs/FeatureStat" } },
        "infill_angles_deg": { "type": "array", "items": { "type": "number" } },
        "infill_spacing_mm": { "$ref": "#/$defs/Estimate" },
        "extrusion_multiplier": { "$ref": "#/$defs/Estimate" },
        "seam": { "$ref": "#/$defs/SeamHint" },
        "travel": { "$ref": "#/$defs/TravelStat" },
        "travel_strategy": { "$ref": "#/$defs/TravelStrategy" },
        "hotspots": { "type": "array", "items": { "$ref": "#/$defs/Hotspot" } }
      }
    },
    "RewriteSpanResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "span_index",
        "accepted",
        "segment_count_before",
        "segment_count_after",
        "new_error_rules"
      ],
      "properties": {
        "span_index": { "type": "integer", "minimum": 0 },
        "accepted": { "type": "boolean" },
        "segment_count_before": { "type": "integer", "minimum": 0 },
        "segment_count_after": { "type": "integer", "minimum": 0 },
        "new_error_rules": { "type": "array", "items": { "type": "string" } }
      }
    },
    "RewriteReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "profile",
        "mode",
        "spans_total",
        "spans_accepted",
        "spans_rejected",
        "segment_count_before",
        "segment_count_after",
        "metrics_before",
        "metrics_after",
        "spans"
      ],
      "properties": {
        "file": { "type": ["string", "null"] },
        "profile": { "type": ["string", "null"] },
        "mode": { "type": "string" },
        "spans_total": { "type": "integer", "minimum": 0 },
        "spans_accepted": { "type": "integer", "minimum": 0 },
        "spans_rejected": { "type": "integer", "minimum": 0 },
        "segment_count_before": { "type": "integer", "minimum": 0 },
        "segment_count_after": { "type": "integer", "minimum": 0 },
        "metrics_before": { "$ref": "#/$defs/Metrics" },
        "metrics_after": { "$ref": "#/$defs/Metrics" },
        "spans": { "type": "array", "items": { "$ref": "#/$defs/RewriteSpanResult" } },
        "license": { "$ref": "#/$defs/LicenseStamp" }
      }
    },
    "ExplainReports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace", "forensics", "verify"],
      "properties": {
        "trace": { "$ref": "#/$defs/TraceReport" },
        "forensics": { "$ref": "#/$defs/ForensicsReport" },
        "verify": { "$ref": "#/$defs/ReviewReport" }
      }
    },
    "ExplainBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "profile", "profiled", "reports", "prompt"],
      "properties": {
        "file": { "type": ["string", "null"] },
        "profile": { "type": ["string", "null"] },
        "profiled": { "type": "boolean" },
        "reports": { "$ref": "#/$defs/ExplainReports" },
        "prompt": { "type": "string" },
        "license": { "$ref": "#/$defs/LicenseStamp" }
      }
    }
  }
}
