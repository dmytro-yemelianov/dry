{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dmytro-yemelianov/dry/spec/dry-reports-v1.schema.json",
  "title": "Dry report outputs v1",
  "description": "Schemas for Dry's report outputs (see docs/11-profiles-and-reports.md). Use the $defs by name to validate a given output: VerifyReport (verify), ReviewReport (review-gcode), ReviewBatch (review-batch), TraceReport (trace-gcode), ForensicsReport (forensics-gcode), RewriteReport (rewrite-gcode), ExplainBundle (explain) and CompareDelta (compare). The `--llm` envelopes of `explain` and `compare` are deliberately absent: model output is not drift-gated, so it has no committed golden to validate.",
  "$defs": {
    "Severity": {
      "type": "string",
      "enum": [
        "error",
        "warning"
      ]
    },
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "severity",
        "segment",
        "message"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "description": "stable kebab-case rule id (see the rule catalog)"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "segment": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "message": {
          "type": "string"
        }
      }
    },
    "LocatedFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "severity",
        "segment",
        "source_line",
        "message"
      ],
      "properties": {
        "rule": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "segment": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "source_line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "message": {
          "type": "string"
        }
      }
    },
    "Metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_time_s",
        "print_time_s",
        "travel_time_s",
        "extruding_distance",
        "travel_distance",
        "extruded_volume",
        "filament_length",
        "segment_count",
        "max_flow_rate"
      ],
      "properties": {
        "total_time_s": {
          "type": "number"
        },
        "print_time_s": {
          "type": "number"
        },
        "travel_time_s": {
          "type": "number"
        },
        "extruding_distance": {
          "type": "number"
        },
        "travel_distance": {
          "type": "number"
        },
        "extruded_volume": {
          "type": "number"
        },
        "filament_length": {
          "type": "number"
        },
        "segment_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_flow_rate": {
          "type": "number"
        }
      }
    },
    "Contracts": {
      "description": "The limits a toolpath was verified against. An absent field disables that check.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bounds": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        },
        "max_flow": {
          "type": "number"
        },
        "speed_range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "monotonic_z": {
          "type": "boolean"
        },
        "min_temp": {
          "type": "number"
        },
        "max_retraction_distance": {
          "type": "number"
        },
        "max_retraction_speed": {
          "type": "number"
        },
        "max_travel_without_retract": {
          "type": "number"
        },
        "first_layer_height_range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "first_layer_speed_range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "bead_volume_tolerance": {
          "type": "number"
        },
        "kinematics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_acceleration_mm_s2": {
              "type": "number"
            },
            "max_junction_velocity_mm_s": {
              "type": "number"
            }
          }
        },
        "rotary": {
          "description": "Rotary-axis limits and reachable workspace of a 5-axis machine. `model` is the rotary mapping the orientations were resolved through \u2014 the same one the emitter uses \u2014 and is always echoed so the angles in a finding can be reproduced.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model"
          ],
          "properties": {
            "model": {
              "$ref": "#/$defs/Kinematics"
            },
            "travel_deg": {
              "description": "Per-axis rotary travel [min,max] in degrees, keyed by axis letter. An absent axis is unconstrained.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "a": {
                  "$ref": "#/$defs/Range"
                },
                "b": {
                  "$ref": "#/$defs/Range"
                },
                "c": {
                  "$ref": "#/$defs/Range"
                }
              }
            },
            "max_rotary_feed_deg_min": {
              "type": "number"
            },
            "envelope_mm": {
              "description": "[[x_lo,x_hi],[y_lo,y_hi],[z_lo,z_hi]] in mm, in MACHINE coordinates (after the rotation is applied) \u2014 not the build volume.",
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "$ref": "#/$defs/Range"
              }
            }
          }
        }
      }
    },
    "Range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "LicenseStamp": {
      "description": "Which licensing mode produced a report. Stamped by the CLI, never by the engine: reports the engine builds carry no `license` key at all, so the property is optional everywhere it appears and older reports stay valid.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "description": "`licensed` or `evaluation`"
        },
        "licensee": {
          "type": "string"
        },
        "tier": {
          "type": "string"
        }
      }
    },
    "Kinematics": {
      "description": "A 5-axis rotary model: which two rotary axes carry the toolframe orientation, plus mechanical offsets.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "pivot_offset",
        "rotary_offset"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ab",
            "ac",
            "bc"
          ]
        },
        "pivot_offset": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "rotary_offset": {
          "$ref": "#/$defs/Range"
        }
      }
    },
    "VerifyReport": {
      "description": "A verification result. `findings` alone cannot distinguish a clean pass from a vacuous one, so a report also states how much it inspected (`segments_inspected`), which rules were in force (`rules_evaluated`), and against what limits (`contracts`). All three are optional: reports written before Dry 0.5 carry only `findings` and remain valid.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findings"
      ],
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        },
        "segments_inspected": {
          "type": "integer",
          "minimum": 0
        },
        "rules_evaluated": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contracts": {
          "$ref": "#/$defs/Contracts"
        },
        "license": {
          "$ref": "#/$defs/LicenseStamp"
        }
      }
    },
    "ReviewReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "profile",
        "segments",
        "metrics",
        "findings",
        "error_count"
      ],
      "properties": {
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "segments": {
          "type": "integer",
          "minimum": 0
        },
        "metrics": {
          "$ref": "#/$defs/Metrics"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocatedFinding"
          }
        },
        "error_count": {
          "type": "integer",
          "minimum": 0
        },
        "segments_inspected": {
          "type": "integer",
          "minimum": 0,
          "description": "How many segments the verify pass inspected. Zero means the pass proved nothing: a clean review over no segments is not the same result as a clean review of a program."
        },
        "rules_evaluated": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Wire ids of every rule that was in force, in catalog order. Present so a review that ran only the always-on structural rules is distinguishable from one checked against a machine profile."
        },
        "license": {
          "$ref": "#/$defs/LicenseStamp"
        }
      }
    },
    "BatchStatus": {
      "description": "One file's verdict in a batch review. `passed` is inspected with no error-severity finding (warnings do not fail a file); `errored` is a file that could not be inspected at all, which is a distinct verdict rather than a failure.",
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "errored"
      ]
    },
    "BatchFileResult": {
      "description": "One file's entry in a ReviewBatch. Exactly one of `review` / `error` is present \u2014 enforced by the `oneOf` below rather than left to prose \u2014 and `status` follows from which one: an inspected file is `passed`/`failed` and carries a report, a file that could not be inspected at all is `errored` and carries the error message. The nested report is an ordinary ReviewReport, not a batch-specific shape.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "status"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/BatchStatus"
        },
        "review": {
          "$ref": "#/$defs/ReviewReport"
        },
        "error": {
          "type": "string",
          "description": "the read/import error's own message"
        }
      },
      "oneOf": [
        {
          "title": "inspected",
          "required": [
            "review"
          ],
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed"
              ]
            }
          }
        },
        {
          "title": "not inspected",
          "required": [
            "error"
          ],
          "not": {
            "required": [
              "review"
            ]
          },
          "properties": {
            "status": {
              "const": "errored"
            }
          }
        }
      ]
    },
    "RuleTally": {
      "description": "Per-rule roll-up across a batch. `files` counts files carrying at least one finding for the rule \u2014 a rule twice in one file counts one file and two findings.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "errors",
        "warnings",
        "files"
      ],
      "properties": {
        "rule": {
          "type": "string"
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ReviewBatch": {
      "description": "The `review-batch` output: one envelope over N files, each nesting an unmodified ReviewReport. The licence is stamped once here, never on the nested reports. `findings_by_rule` is ascending by rule id and `results` is in input order, both deterministic.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files_total",
        "files_passed",
        "files_failed",
        "files_errored",
        "profile",
        "findings_by_rule",
        "results"
      ],
      "properties": {
        "files_total": {
          "type": "integer",
          "minimum": 0
        },
        "files_passed": {
          "type": "integer",
          "minimum": 0
        },
        "files_failed": {
          "type": "integer",
          "minimum": 0
        },
        "files_errored": {
          "type": "integer",
          "minimum": 0
        },
        "profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "findings_by_rule": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuleTally"
          }
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BatchFileResult"
          }
        },
        "license": {
          "$ref": "#/$defs/LicenseStamp"
        }
      }
    },
    "TraceWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "start_time_s",
        "end_time_s",
        "segment_start",
        "segment_end",
        "duration_s",
        "print_time_s",
        "travel_time_s",
        "dwell_time_s",
        "extruding_distance_mm",
        "travel_distance_mm",
        "extruded_volume_mm3",
        "filament_mm",
        "max_feedrate_mm_min",
        "max_flow_mm3_s"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "start_time_s": {
          "type": "number"
        },
        "end_time_s": {
          "type": "number"
        },
        "segment_start": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "segment_end": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "source_line_start": {
          "type": "integer",
          "minimum": 0
        },
        "source_line_end": {
          "type": "integer",
          "minimum": 0
        },
        "duration_s": {
          "type": "number"
        },
        "print_time_s": {
          "type": "number"
        },
        "travel_time_s": {
          "type": "number"
        },
        "dwell_time_s": {
          "type": "number"
        },
        "extruding_distance_mm": {
          "type": "number"
        },
        "travel_distance_mm": {
          "type": "number"
        },
        "extruded_volume_mm3": {
          "type": "number"
        },
        "filament_mm": {
          "type": "number"
        },
        "max_feedrate_mm_min": {
          "type": "number"
        },
        "max_flow_mm3_s": {
          "type": "number"
        }
      }
    },
    "TraceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_s",
        "segment_count",
        "moving_segment_count",
        "total_time_s",
        "print_time_s",
        "travel_time_s",
        "dwell_time_s",
        "extruding_distance_mm",
        "travel_distance_mm",
        "extruded_volume_mm3",
        "filament_mm",
        "max_feedrate_mm_min",
        "max_flow_mm3_s",
        "windows",
        "layers"
      ],
      "properties": {
        "window_s": {
          "type": "number"
        },
        "segment_count": {
          "type": "integer",
          "minimum": 0
        },
        "moving_segment_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_time_s": {
          "type": "number"
        },
        "print_time_s": {
          "type": "number"
        },
        "travel_time_s": {
          "type": "number"
        },
        "dwell_time_s": {
          "type": "number"
        },
        "extruding_distance_mm": {
          "type": "number"
        },
        "travel_distance_mm": {
          "type": "number"
        },
        "extruded_volume_mm3": {
          "type": "number"
        },
        "filament_mm": {
          "type": "number"
        },
        "max_feedrate_mm_min": {
          "type": "number"
        },
        "max_flow_mm3_s": {
          "type": "number"
        },
        "windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TraceWindow"
          }
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LayerTraceLinkage"
          },
          "description": "layers are keyed on the Z of extruding moves, and an empty array means \"this toolpath has no Z-keyed layers\" rather than \"the layer data is missing\": it is empty unless the producer asked for analytics (`trace-gcode --analytics`), and empty even then for a toolpath with no extruding move (travel-only, or subtractive/laser work that deposits nothing) or whose extruding moves carry no Z at all (2D XY-only work). The windows and totals are fully populated in every one of those cases"
        },
        "analytics": {
          "$ref": "#/$defs/TraceAnalytics"
        }
      }
    },
    "LayerTraceLinkage": {
      "description": "One layer's segment range and aggregates \u2014 a layer is a window whose boundary is Z instead of time, so it carries a TraceWindow's field set minus the time bounds. `segment_end` is exclusive. A layer here is a *pass* in execution order, so a re-visited Z produces a second entry; ForensicsReport.layers.layer_count counts distinct Z levels instead and is therefore \u2264 this array's length.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer_index",
        "z_mm",
        "segment_start",
        "segment_end",
        "print_time_s",
        "travel_time_s",
        "extruded_volume_mm3",
        "dwell_time_s",
        "extruding_distance_mm",
        "travel_distance_mm",
        "filament_mm",
        "max_feedrate_mm_min",
        "max_flow_mm3_s"
      ],
      "properties": {
        "layer_index": {
          "type": "integer",
          "minimum": 0
        },
        "z_mm": {
          "type": "number"
        },
        "segment_start": {
          "type": "integer",
          "minimum": 0
        },
        "segment_end": {
          "type": "integer",
          "minimum": 0
        },
        "print_time_s": {
          "type": "number"
        },
        "travel_time_s": {
          "type": "number"
        },
        "extruded_volume_mm3": {
          "type": "number"
        },
        "dwell_time_s": {
          "type": "number"
        },
        "extruding_distance_mm": {
          "type": "number"
        },
        "travel_distance_mm": {
          "type": "number"
        },
        "filament_mm": {
          "type": "number"
        },
        "max_feedrate_mm_min": {
          "type": "number"
        },
        "max_flow_mm3_s": {
          "type": "number"
        },
        "source_line_start": {
          "type": "integer",
          "minimum": 0
        },
        "source_line_end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Percentiles": {
      "description": "Exact order statistics under one nearest-rank (inverse-CDF, lower) definition: quantile(p) is the first value whose cumulative weight reaches p\u00b7\u03a3W, over samples sorted ascending. No interpolation, so every number here is a value that actually occurred. `p50` is the median under this definition, which differs from ForensicsReport's `median` (that one averages the two middle values on an even count).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "p50",
        "p95",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "p50": {
          "type": "number"
        },
        "p95": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "PhaseStats": {
      "description": "Time-weighted statistics over the moving segments of one phase (print or travel); dwell time is excluded. A segment whose feedrate or flow was non-finite is counted in `nonfinite_samples` and excluded from the totals and the means (which share one population) and from whichever percentile channel was non-finite \u2014 so every number here is a real `number`, never the `null` a non-finite f64 would serialize as. Only `segments` counts those segments, which is why `print.segments + travel.segments` still equals the summary's `moving_segment_count` while the phase totals can fall short of the summary's own totals (those keep propagating non-finite values). A null percentile block means no finite-valued sample carried weight \u2014 a phase with no motion has no percentiles, and 0.0 would be indistinguishable from a real stall.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segments",
        "time_s",
        "distance_mm",
        "volume_mm3",
        "mean_feedrate_mm_min",
        "mean_flow_mm3_s",
        "feedrate_mm_min",
        "flow_mm3_s",
        "nonfinite_samples"
      ],
      "properties": {
        "segments": {
          "type": "integer",
          "minimum": 0
        },
        "time_s": {
          "type": "number"
        },
        "distance_mm": {
          "type": "number"
        },
        "volume_mm3": {
          "type": "number"
        },
        "mean_feedrate_mm_min": {
          "type": [
            "number",
            "null"
          ]
        },
        "mean_flow_mm3_s": {
          "type": [
            "number",
            "null"
          ]
        },
        "feedrate_mm_min": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Percentiles"
            }
          ]
        },
        "flow_mm3_s": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Percentiles"
            }
          ]
        },
        "nonfinite_samples": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "WindowOutliers": {
      "description": "Windows whose peak flow stands out against the batch \u2014 an observation, never a gate: there is no rule id, no severity and no effect on any exit code. The reference is the already-published TraceAnalytics.window_flow_mm3_s.p50, so the threshold is reproducible from two numbers in the same document. Strictly greater than, so k = 1 on a constant-flow file flags nothing.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "k",
        "threshold_mm3_s",
        "window_indices"
      ],
      "properties": {
        "k": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "threshold_mm3_s": {
          "type": [
            "number",
            "null"
          ]
        },
        "window_indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "LayerStats": {
      "description": "Order statistics over the per-layer aggregates in TraceSummary.layers (unweighted; one sample per layer).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer_count",
        "print_time_s",
        "extruded_volume_mm3",
        "slowest_layer_index"
      ],
